# ============================================================
# ECHOGUARD - REALTIME VOICE RELIABILITY INFRASTRUCTURE
# Environment Configuration Template (.env.example)
# ============================================================

# ------------------------------------------------------------
# 1. CORE LLM INTELLIGENCE (Google Gemini)
# ------------------------------------------------------------
# Required by both browser runtime and server for arbitrary reasoning.
# Uses official google-genai SDK (default model: gemini-2.5-flash-lite)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ------------------------------------------------------------
# 2. RIME TTS AUTHENTICATION (Primary Spoken Output)
# ------------------------------------------------------------
# Rime API authentication (Server/Agent only - NEVER exposed to browser)
# Active Model: coda | Active Speaker: celeste | Language: en
RIME_API_KEY=your_rime_api_key_here

# Default Rime Voice Configuration
RIME_MODEL=coda
RIME_SPEAKER=celeste
RIME_LANG=en
RIME_SEGMENTATION=bySentence

# ------------------------------------------------------------
# 3. RUNTIME TRANSPORT & AUDIO FORMAT DISTINCTION
# ------------------------------------------------------------
# NOTE: EchoGuard supports two distinct runtimes:
#
# A) Browser Production / Web Demo Path (FastAPI Server + Web Client):
#    - Browser microphone -> Web Speech API -> FastAPI /api/chat -> Gemini
#    - Spoken output: Rime REST HTTP endpoint (https://users.rime.ai/v1/rime-tts)
#    - Audio format: MP3 (audio/mpeg, 22050Hz)
#    - Interruption: 0.13 ms software audio buffer flush + atomic generation fencing
#
# B) Headless LiveKit Worker Path (agent/main.py - optional separate worker):
#    - LiveKit WebRTC room integration (livekit.plugins.rime)
#    - Spoken output: Rime WebSocket endpoint (wss://users-ws.rime.ai/ws3)
#    - Audio format: PCM (16000Hz)
#
# Variables below configure the headless LiveKit worker:
RIME_TRANSPORT=websocket
RIME_AUDIO_FORMAT=pcm
RIME_SAMPLE_RATE=16000

# LiveKit Server Credentials (Only required if running agent/main.py worker)
LIVEKIT_URL=wss://your-livekit-url
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional alternative LLM (if testing external fallback providers)
OPENAI_API_KEY=your_openai_api_key_if_used

# ------------------------------------------------------------
# 4. SERVER BINDING
# ------------------------------------------------------------
PORT=8000
HOST=127.0.0.1
