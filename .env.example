# ============================================================
# ECHOGUARD - REALTIME VOICE RELIABILITY INFRASTRUCTURE
# Environment Configuration Template
# ============================================================

# Rime TTS Authentication (Server/Agent only - NEVER expose to browser)
# Primary spoken output provider using official LiveKit Rime plugin
RIME_API_KEY=your_rime_api_key_here

# LiveKit WebRTC Cloud or Local Server Configuration
LIVEKIT_URL=wss://your-livekit-url
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# LLM Intelligence (Google Gemini / OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_if_used

# Server Port
PORT=8000
HOST=127.0.0.1

# Active Rime Configuration Defaults
RIME_MODEL=coda
RIME_SPEAKER=celeste
RIME_LANG=en
RIME_SEGMENTATION=bySentence
RIME_TRANSPORT=websocket
RIME_AUDIO_FORMAT=pcm
RIME_SAMPLE_RATE=16000
